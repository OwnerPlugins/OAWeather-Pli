msgstr "លំនាំដើម"

msgid "Defaults"
msgstr "លំនាំដើម"

msgid "Delete"
msgstr "លុប"

msgid "Delete failed"
msgstr "ការលុបបានបរាជ័យ"

msgid "Delete {}?"
msgstr "លុប {}?"

msgid "Detail level in detail view"
msgstr "កម្រិតលម្អិតនៅក្នុងទិដ្ឋភាពលម្អិត"

